}, {
  "@id" : "https://edint.es/def/servicios-publicos#AdministrativeProcedure",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Formal process followed by a public administration to manage, evaluate, and resolve a request, case, or administrative action."
  }, {
    "@language" : "es",
    "@value" : "Proceso formal seguido por una administración pública para gestionar, evaluar y resolver una solicitud, expediente o actuación administrativa."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Administrative Procedure"
  }, {
    "@language" : "es",
    "@value" : "Procedimiento Administrativo"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#DestinadoProcedimiento",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This class represent the target entity of a Public Service."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Destinado Procedimiento"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://xmlns.com/foaf/0.1/Agent"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#PublicService",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Municipal public service offered by a public administration or by an entity on its behalf."
  }, {
    "@language" : "es",
    "@value" : "Servicio público municipal ofrecido por una administración pública o por una entidad en su nombre."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Public Service"
  }, {
    "@language" : "es",
    "@value" : "Servicio Público"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/vocab/cpsv#PublicService"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#availability",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Indica la disponibilidad actual o declarada del servicio público."
  }, {
    "@language" : "en",
    "@value" : "Indicates the current or declared availability of the public service."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#PublicService"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Availability"
  }, {
    "@language" : "es",
    "@value" : "Disponibilidad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#hasAdministrativeProcedure",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona un servicio público con el procedimiento administrativo mediante el cual se gestiona, tramita o resuelve."
  }, {
    "@language" : "en",
    "@value" : "Relates a public service to the administrative procedure through which it is managed, processed, or resolved."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#PublicService"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has Administrative Procedure"
  }, {
    "@language" : "es",
    "@value" : "tiene Procedimiento Administrativo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#AdministrativeProcedure"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#identifier",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A unique textual or numeric code assigned to a public service to enable its identification and management across systems or administrative processes."
  }, {
    "@language" : "es",
    "@value" : "Código textual o numérico único asignado a un servicio público para permitir su identificación y gestión en sistemas o procesos administrativos."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#PublicService"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Identificador"
  }, {
    "@language" : "en",
    "@value" : "Identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#resolutionPeriod",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Periodo de tiempo esperado o establecido para resolver un procedimiento administrativo asociado a un servicio público."
  }, {
    "@language" : "en",
    "@value" : "The expected or established period of time required to resolve an administrative procedure associated to a public service."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#AdministrativeProcedure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Periodo de resolución"
  }, {
    "@language" : "en",
    "@value" : "Resolution Period"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#duration"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#stateProcedure",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Estado actual del proceso de resolución asociado a un servicio público, que indica si no ha comenzado, está en curso, ha sido resuelto o ha sido cerrado."
  }, {
    "@language" : "en",
    "@value" : "The current state of the resolution process associated with a public service, indicating whether it has not started, is in progress, has been resolved, or has been closed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#AdministrativeProcedure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Estado del Procedimiento"
  }, {
    "@language" : "en",
    "@value" : "State of Procedure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#typeProcedure",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona un procedimiento administrativo con el tipo o categoría que lo clasifica según sus características de tramitación."
  }, {
    "@language" : "en",
    "@value" : "Relates an administrative procedure to the type or category that classifies it according to its processing characteristics."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#AdministrativeProcedure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Tipo de Procedimiento Administrativo"
  }, {
    "@language" : "en",
    "@value" : "Type of Administrative Procedure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid11"
  } ]
}, {
  "@id" : "https://edint.es/def/servicios-publicos#typePublicService",
