  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona un servicio público con el concepto que representa su tipo o categoría dentro de un esquema de clasificación de servicios públicos."
  }, {
    "@language" : "en",
    "@value" : "Relates a public service to the concept that represents its type or category within a public service classification scheme."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/servicios-publicos#PublicService"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Tipo de Servicio Público"
  }, {
    "@language" : "en",
    "@value" : "Type of Public Service"
  } ],
