#################################################################
# Concept scheme
#################################################################

edintkos:PublicServiceType
    a skos:ConceptScheme ;
    dct:issued "2026-05-11"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "Tipos de servicios públicos"@es ;
    skos:prefLabel "Public service types"@en ;
    dct:description "Vocabulario controlado para clasificar servicios públicos municipales."@es ;
    dct:title "Esquema de conceptos agrupando tipos de Servicios Municipales"@es .
    

