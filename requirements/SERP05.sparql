# SERP05: ¿Cuál es el periodo esperado de resolución de cada procedimiento administrativo?

PREFIX serpub: <https://edint.es/def/servicios-publicos#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?procedimiento ?etiquetaProcedimiento ?periodoResolucion
WHERE {
  ?procedimiento a serpub:AdministrativeProcedure ;
                 serpub:resolutionPeriod ?periodoResolucion .

  OPTIONAL {
    ?procedimiento rdfs:label ?etiquetaProcedimiento .
    FILTER(LANG(?etiquetaProcedimiento) = "es")
  }
}
ORDER BY ?etiquetaProcedimiento